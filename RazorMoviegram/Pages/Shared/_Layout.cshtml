<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Moviegram</title>

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RazorMoviegram.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    Moviegram
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMenu"
                        aria-controls="navbarMenu"
                        aria-expanded="false"
                        aria-label="Відкрити меню">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="navbarMenu">
                    <div class="navbar-nav ms-3">
                        <a class="nav-item nav-link" asp-page="/Index">
                            Головна
                        </a>

                        <a class="nav-item nav-link" asp-page="/Movie/Index">
                            Вибір редакції
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container body-content mt-5 pt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

        <hr />

        <footer class="text-muted">
            <p>&copy; @DateTime.Now.Year - Moviegram</p>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>